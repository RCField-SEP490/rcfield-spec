// =========================================================

// =========================================================
// ENUMS
// =========================================================

Enum AuthProvider {
  LOCAL
  GOOGLE
}

Enum UserRole {
  CUSTOMER
  PROVIDER
  STAFF
  ADMIN
}

Enum CafeStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

Enum VehicleTier {
  STANDARD
  PREMIUM
  RESTRICTED
}

Enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

Enum BookingMode {
  RENTAL
  BYOC
}

Enum BookingSource {
  APP
  STAFF_MANUAL
}

Enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  EXTENDING
  CHECKING_OUT
  DISPUTED
  COMPLETED
  CANCELLED
}

Enum PaymentComponentType {
  SLOT_FEE
  RENTAL_FEE
  SECURITY_DEPOSIT
  EXTENSION_FEE
  DAMAGE_CHARGE
  FB_PREORDER
}

Enum PaymentComponentStatus {
  PENDING
  HELD
  DISBURSED
  REFUNDED
  PARTIALLY_REFUNDED
}

Enum InspectionType {
  CHECK_IN
  CHECK_OUT
}

Enum ExtensionProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

Enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
}

Enum DisputeFavor {
  CUSTOMER
  PROVIDER
}

Enum FnbOrderType {
  PRE_ORDER
  ON_SITE
}

Enum FnbOrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

Enum NotificationChannel {
  PUSH
  SMS
  EMAIL
}

Enum NotificationStatus {
  SENT
  FAILED
  PENDING
}

Enum PaymentTransactionType {
  PAYMENT
  REFUND
}

Enum TrustScoreReason {
  NO_SHOW
  DAMAGE_CONFIRMED
  DISPUTE_LOST
  BOOKING_STREAK
  ADMIN_ADJUSTMENT
}

Enum DiscountType {
  PERCENT
  FIXED
}

Enum PromoApplicableTo {
  ALL
  RENTAL
  BYOC
}

Enum MaintenanceType {
  SCHEDULED
  REPAIR
  INSPECTION
}

// =========================================================
// 1. USER MANAGEMENT
// =========================================================

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  email varchar(255) [not null, unique]
  phone varchar(20) [null]
  full_name varchar(255) [not null]
  password_hash text [null, note: 'NULL nếu đăng nhập Google']
  auth_provider AuthProvider [not null, default: 'LOCAL']
  role UserRole [not null]
  trust_score decimal(5,2) [not null, default: 100.00, note: 'Chỉ có nghĩa với CUSTOMER (0–100)']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null, note: 'Soft delete']

  Indexes {
    email [unique, name: 'idx_users_email']
    role [name: 'idx_users_role']
  }
}

Table refresh_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token text [not null, unique, note: 'Hashed token']
  expires_at timestamptz [not null, note: '7 ngày']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_refresh_tokens_user_id']
    token [unique, name: 'idx_refresh_tokens_token']
  }
}

Table password_reset_tokens {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id]
  token text [not null, unique, note: 'UUID random']
  expires_at timestamptz [not null, note: '15 phút']
  used_at timestamptz [null, note: 'NULL = chưa dùng']
  created_at timestamptz [not null, default: `now()`]
}

// =========================================================
// 2. CAFE (CHI NHÁNH)
// =========================================================

Table cafes {
  id uuid [pk, default: `gen_random_uuid()`]
  provider_id uuid [not null, ref: > users.id, note: 'PROVIDER role']
  name varchar(255) [not null]
  slug varchar(100) [not null, unique, note: 'VD: rcfield-quan-7']
  description text [null]
  phone varchar(20) [null]
  status CafeStatus [not null, default: 'PENDING']
  cover_image_url text [null]

  // Địa chỉ
  address text [not null]
  district varchar(100) [not null]
  city varchar(100) [not null]
  latitude decimal(10,7) [null]
  longitude decimal(10,7) [null]

  // Config vận hành (per-branch)
  operating_hours jsonb [not null, note: '{ mon: {open, close, is_closed}, ... }']
  track_types text [not null, default: '{}', note: 'text[] — DRIFT, CIRCUIT, OFFROAD']
  slot_duration_minutes integer [not null, default: 60]
  slot_fee_rate decimal(15,2) [not null]
  max_concurrent_bookings integer [not null, default: 10]
  min_booking_notice_minutes integer [not null, default: 60]
  byoc_capacity integer [not null, default: 5]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    slug [unique, name: 'idx_cafes_slug']
    provider_id [name: 'idx_cafes_provider_id']
    status [name: 'idx_cafes_status']
    (city, district) [name: 'idx_cafes_city_district']
    (latitude, longitude) [name: 'idx_cafes_location']
  }
}

Table cafe_images {
  id uuid [pk, default: `gen_random_uuid()`]
  cafe_id uuid [not null, ref: > cafes.id]
  url text [not null, note: 'Cloudinary URL']
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    cafe_id [name: 'idx_cafe_images_cafe_id']
  }
}

Table cafe_closures {
  id uuid [pk, default: `gen_random_uuid()`]
  cafe_id uuid [not null, ref: > cafes.id]
  closed_date date [not null, note: 'Ngày đóng cửa — chỉ ngày, không có giờ']
  reason varchar(255) [null, note: 'VD: Nghỉ Tết, Bảo trì sân']
  created_by uuid [not null, ref: > users.id, note: 'PROVIDER hoặc ADMIN']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    (cafe_id, closed_date) [unique, name: 'idx_cafe_closures_date']
    cafe_id [name: 'idx_cafe_closures_cafe_id']
  }
}

Table cafe_announcements {
  id uuid [pk, default: `gen_random_uuid()`]
  cafe_id uuid [not null, ref: > cafes.id]
  title varchar(255) [not null]
  content text [null]
  image_url text [null, note: 'Cloudinary URL']
  starts_at timestamptz [not null, default: `now()`]
  ends_at timestamptz [null, note: 'NULL = hiển thị mãi']
  is_active boolean [not null, default: true]
  created_by uuid [not null, ref: > users.id, note: 'PROVIDER hoặc STAFF']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    (cafe_id, is_active, starts_at) [name: 'idx_cafe_announcements_cafe_id']
  }
}

// =========================================================
// 3. STAFF
// =========================================================

Table staff_cafe_assignments {
  id uuid [pk, default: `gen_random_uuid()`]
  staff_id uuid [not null, unique, ref: > users.id, note: 'STAFF role — UNIQUE: 1 staff → 1 cafe']
  cafe_id uuid [not null, ref: > cafes.id]
  assigned_at timestamptz [not null, default: `now()`]
  assigned_by uuid [not null, ref: > users.id, note: 'PROVIDER hoặc ADMIN']

  Indexes {
    staff_id [unique, name: 'idx_staff_cafe_staff_id']
    cafe_id [name: 'idx_staff_cafe_cafe_id']
  }
}

// =========================================================
// 4. FLEET (ĐỘI XE)
// =========================================================

Table vehicles {
  id uuid [pk, default: `gen_random_uuid()`]
  cafe_id uuid [not null, ref: > cafes.id]
  name varchar(255) [not null, note: 'VD: Traxxas Slash 4x4']
  description text [null]
  tier VehicleTier [not null]
  status VehicleStatus [not null, default: 'AVAILABLE']
  hourly_rate decimal(15,2) [not null]
  security_deposit decimal(15,2) [not null]
  damage_multiplier decimal(4,2) [not null, default: 1.00, note: '1.0 / 1.5 / 2.0']
  compatible_track_types text [not null, default: '{}', note: 'text[] — DRIFT/CIRCUIT/OFFROAD. Rỗng = chạy được tất cả. Chỉ áp dụng RENTAL']
  cover_image_url text [null]
  last_maintenance_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null, note: 'Soft delete']

  Indexes {
    cafe_id [name: 'idx_vehicles_cafe_id']
    status [name: 'idx_vehicles_status']
    tier [name: 'idx_vehicles_tier']
  }
}

Table vehicle_images {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, ref: > vehicles.id]
  url text [not null, note: 'Cloudinary URL']
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    vehicle_id [name: 'idx_vehicle_images_vehicle_id']
  }
}

Table vehicle_maintenance_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  vehicle_id uuid [not null, ref: > vehicles.id]
  type MaintenanceType [not null]
  description text [not null]
  cost decimal(15,2) [null]
  performed_by uuid [null, ref: > users.id, note: 'NULL nếu gửi ngoài bảo hành']
  performed_at timestamptz [not null]
  next_scheduled_at timestamptz [null]
  related_booking_id uuid [null, ref: > bookings.id, note: 'Nếu phát sinh từ damage']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    vehicle_id [name: 'idx_vehicle_maintenance_vehicle_id']
    (vehicle_id, performed_at) [name: 'idx_vehicle_maintenance_performed_at']
  }
}

// =========================================================
// 5. PROMOTIONS (MÃ GIẢM GIÁ)
// =========================================================

Table promotions {
  id uuid [pk, default: `gen_random_uuid()`]
  code varchar(50) [not null, unique, note: 'VD: RCFIELD2026']
  description text [null]
  discount_type DiscountType [not null]
  discount_value decimal(15,2) [not null, note: 'VD: 20 (20%) hoặc 50000 (50k VNĐ)']
  max_discount_amount decimal(15,2) [null, note: 'Trần giảm tối đa cho PERCENT. NULL = không giới hạn']
  min_order_amount decimal(15,2) [null, note: 'Đơn tối thiểu. NULL = không giới hạn']
  max_uses integer [null, note: 'NULL = không giới hạn']
  max_uses_per_user integer [not null, default: 1]
  uses_count integer [not null, default: 0]
  applicable_to PromoApplicableTo [not null, default: 'ALL']
  cafe_id uuid [null, ref: > cafes.id, note: 'NULL = global toàn chuỗi. NOT NULL = chỉ 1 chi nhánh']
  starts_at timestamptz [not null]
  expires_at timestamptz [null, note: 'NULL = không hết hạn']
  is_active boolean [not null, default: true]
  created_by uuid [not null, ref: > users.id, note: 'PROVIDER hoặc ADMIN']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    code [unique, name: 'idx_promotions_code']
    cafe_id [name: 'idx_promotions_cafe_id']
    expires_at [name: 'idx_promotions_expires_at']
  }
}

Table promotion_usages {
  id uuid [pk, default: `gen_random_uuid()`]
  promotion_id uuid [not null, ref: > promotions.id]
  booking_id uuid [not null, unique, ref: > bookings.id, note: '1 booking chỉ dùng 1 mã']
  user_id uuid [not null, ref: > users.id]
  discount_amount decimal(15,2) [not null, note: 'Số tiền thực tế được giảm']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [unique, name: 'idx_promotion_usages_booking']
    promotion_id [name: 'idx_promotion_usages_promotion_id']
    user_id [name: 'idx_promotion_usages_user_id']
  }
}

// =========================================================
// 6. BOOKINGS (ĐẶT LỊCH)
// =========================================================

Table bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  customer_id uuid [not null, ref: > users.id, note: 'Luôn có account — guest tạo account trước']
  cafe_id uuid [not null, ref: > cafes.id]
  vehicle_id uuid [null, ref: > vehicles.id, note: 'NULL nếu BYOC']
  mode BookingMode [not null]
  source BookingSource [not null, default: 'APP']
  track_type varchar(50) [not null, note: 'DRIFT / CIRCUIT / OFFROAD']
  status BookingStatus [not null, default: 'PENDING']
  slot_start timestamptz [not null]
  slot_end timestamptz [not null]
  slot_count integer [not null, default: 1]
  payment_expires_at timestamptz [not null, note: 'created_at + 30 phút — cron auto-cancel khi quá hạn']
  snapshot jsonb [not null, note: 'BookingSnapshot — bất biến sau khi tạo. Xem spec section 3.7']
  promotion_id uuid [null, ref: > promotions.id]
  discount_amount decimal(15,2) [null]
  notes text [null]
  cancelled_by uuid [null, ref: > users.id]
  cancelled_at timestamptz [null]
  cancellation_reason text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    customer_id [name: 'idx_bookings_customer_id']
    cafe_id [name: 'idx_bookings_cafe_id']
    vehicle_id [name: 'idx_bookings_vehicle_id']
    status [name: 'idx_bookings_status']
    slot_start [name: 'idx_bookings_slot_start']
    (cafe_id, track_type) [name: 'idx_bookings_track_type']
    payment_expires_at [name: 'idx_bookings_payment_expires']
    (vehicle_id, slot_start, slot_end) [name: 'idx_bookings_vehicle_slot']
  }
}

// =========================================================
// 7. PAYMENT
// =========================================================

Table payment_components {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  type PaymentComponentType [not null]
  amount decimal(15,2) [not null, note: 'Bất biến sau khi tạo']
  status PaymentComponentStatus [not null, default: 'PENDING']
  disbursed_to uuid [null, ref: > users.id, note: 'provider_id khi disburse']
  disbursed_at timestamptz [null]
  refunded_at timestamptz [null]
  refunded_amount decimal(15,2) [null, note: 'Dùng khi PARTIALLY_REFUNDED']
  note text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_payment_components_booking_id']
    status [name: 'idx_payment_components_status']
  }
}

Table payment_transactions {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  gateway varchar(50) [not null, note: 'VNPAY / MOMO / VIETQR']
  gateway_transaction_id varchar(255) [null]
  type PaymentTransactionType [not null]
  amount decimal(15,2) [not null]
  status varchar(50) [not null, note: 'Raw status code từ gateway']
  raw_request jsonb [null]
  raw_response jsonb [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_payment_transactions_booking_id']
    gateway_transaction_id [name: 'idx_payment_transactions_gateway_txn']
  }
}

// =========================================================
// 8. INSPECTION (CHECK-IN / CHECK-OUT)
// =========================================================

Table inspection_records {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  type InspectionType [not null]
  performed_by uuid [not null, ref: > users.id, note: 'Staff']
  photos jsonb [not null, note: '{ front, back, left, right } — 4 Cloudinary URLs']
  checklist jsonb [not null, note: '{ scratches, cracks, missing_parts, notes }']
  pre_existing_flag boolean [not null, default: false, note: 'Hư hỏng có sẵn (check-in)']
  damage_noted boolean [not null, default: false, note: 'Damage mới (check-out)']
  damage_description text [null]
  damage_cost_estimate decimal(15,2) [null]
  customer_confirmed boolean [not null, default: false]
  customer_confirmed_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_inspection_records_booking_id']
    (booking_id, type) [unique, name: 'idx_inspection_booking_type']
  }
}

// =========================================================
// 9. EXTENSION & DISPUTE
// =========================================================

Table extension_proposals {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  proposed_by uuid [not null, ref: > users.id, note: 'Staff']
  duration_minutes integer [not null]
  fee_amount decimal(15,2) [not null]
  status ExtensionProposalStatus [not null, default: 'PENDING']
  responded_by uuid [null, ref: > users.id, note: 'Customer']
  responded_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_extension_proposals_booking_id']
  }
}

Table disputes {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique, ref: > bookings.id, note: 'Mỗi booking max 1 dispute']
  opened_by uuid [not null, ref: > users.id]
  reason text [not null]
  evidence_photos text [not null, default: '{}', note: 'text[] — Cloudinary URLs']
  status DisputeStatus [not null, default: 'OPEN']
  resolution text [null]
  resolution_favor DisputeFavor [null]
  resolved_by uuid [null, ref: > users.id, note: 'Admin']
  resolved_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [unique, name: 'idx_disputes_booking_id']
    status [name: 'idx_disputes_status']
  }
}

// =========================================================
// 10. F&B
// =========================================================

Table menu_items {
  id uuid [pk, default: `gen_random_uuid()`]
  cafe_id uuid [not null, ref: > cafes.id]
  name varchar(255) [not null]
  description text [null]
  price decimal(15,2) [not null]
  category varchar(100) [null, note: 'VD: Nước uống, Đồ ăn']
  image_url text [null]
  is_available boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz [null, note: 'Soft delete']

  Indexes {
    cafe_id [name: 'idx_menu_items_cafe_id']
    (cafe_id, is_available) [name: 'idx_menu_items_available']
  }
}

Table fnb_orders {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, ref: > bookings.id]
  type FnbOrderType [not null]
  status FnbOrderStatus [not null, default: 'PENDING']
  total_amount decimal(15,2) [not null, default: 0]
  created_by uuid [not null, ref: > users.id, note: 'Customer (pre-order) hoặc Staff (on-site)']
  confirmed_by uuid [null, ref: > users.id, note: 'Staff confirm']
  confirmed_at timestamptz [null]
  notes text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [name: 'idx_fnb_orders_booking_id']
  }
}

Table fnb_order_items {
  id uuid [pk, default: `gen_random_uuid()`]
  order_id uuid [not null, ref: > fnb_orders.id]
  menu_item_id uuid [not null, ref: > menu_items.id]
  quantity integer [not null, note: 'CHECK quantity > 0']
  unit_price decimal(15,2) [not null, note: 'Snapshot giá tại thời điểm order']
  item_name_snapshot varchar(255) [not null, note: 'Snapshot tên item']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    order_id [name: 'idx_fnb_order_items_order_id']
  }
}

// =========================================================
// 11. REVIEWS
// =========================================================

Table reviews {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique, ref: > bookings.id, note: '1 booking 1 review']
  cafe_id uuid [not null, ref: > cafes.id, note: 'Denormalized để query nhanh']
  customer_id uuid [not null, ref: > users.id]
  rating integer [not null, note: 'CHECK rating BETWEEN 1 AND 5']
  comment text [null]
  is_visible boolean [not null, default: true, note: 'Provider/Admin có thể ẩn review vi phạm']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    booking_id [unique, name: 'idx_reviews_booking_id']
    (cafe_id, is_visible, created_at) [name: 'idx_reviews_cafe_id']
  }
}

// =========================================================
// 12. NOTIFICATIONS & SYSTEM
// =========================================================

Table notification_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'Người nhận']
  booking_id uuid [null, ref: > bookings.id]
  type varchar(100) [not null, note: 'VD: BOOKING_CONFIRMED, EXTENSION_PROPOSED']
  channel NotificationChannel [not null]
  title varchar(255) [not null]
  body text [not null]
  status NotificationStatus [not null, default: 'PENDING']
  error text [null]
  sent_at timestamptz [null]
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_notification_logs_user_id']
    booking_id [name: 'idx_notification_logs_booking_id']
  }
}

Table feature_flags {
  id uuid [pk, default: `gen_random_uuid()`]
  feature_key varchar(100) [not null, unique, note: 'VD: AI_DAMAGE_DETECTION, FNB']
  display_name varchar(255) [not null]
  description text [null]
  is_enabled boolean [not null, default: false]
  is_trial boolean [not null, default: false]
  trial_ends_at timestamptz [null]
  enabled_by uuid [null, ref: > users.id, note: 'ADMIN']
  enabled_at timestamptz [null]
  note text [null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Indexes {
    feature_key [unique, name: 'idx_feature_flags_key']
    is_enabled [name: 'idx_feature_flags_enabled']
  }
}

// =========================================================
// 13. TRUST SCORE
// =========================================================

Table trust_score_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null, ref: > users.id, note: 'CUSTOMER bị ảnh hưởng']
  booking_id uuid [null, ref: > bookings.id]
  delta decimal(5,2) [not null, note: 'Dương = tăng, âm = giảm. VD: -10.00, +5.00']
  score_before decimal(5,2) [not null]
  score_after decimal(5,2) [not null]
  reason TrustScoreReason [not null]
  note text [null, note: 'Admin ghi khi ADMIN_ADJUSTMENT']
  created_by uuid [null, ref: > users.id, note: 'NULL = system tự động']
  created_at timestamptz [not null, default: `now()`]

  Indexes {
    user_id [name: 'idx_trust_score_logs_user_id']
    booking_id [name: 'idx_trust_score_logs_booking_id']
  }
}
